<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ⚠️ **ここが無いと実機でカメラが許可できない。**
         Capacitor の初期状態は INTERNET だけで、カメラもマイクも
         宣言されていなかった。Web ブラウザでは動くのに、アプリに
         したとたん「カメラが許可できない」になる
         （2026-08-15、伊波さんが内部テストの実機で発見）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- 写真アプリへ直接しまうために要る（2026-08-16、伊波さん「保存の
         タイミングが遅い（自分のファイルに保存時）」で共有シートをやめた）。
         ⚠️ **書き込みだけ。読む権限は宣言しないこと。**
            READ_MEDIA_IMAGES / READ_MEDIA_VIDEO は「写真を読む」ための
            もので、保存には要らない。付けると Play の審査で
            「申告されていない権限」として警告が出る（実際に出た）。
            tinyCUBE は撮って保存するだけで、人の写真を覗く必要はない。
         ⚠️ Android 10 (API 29) 以降は保存にも権限が要らない。
            maxSdkVersion="28" で、古い端末のときだけ求める -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- カメラが無い端末（一部のタブレット）でも入れられるようにする。
         required="true" にすると、そういう端末が Play の対象から外れる -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
