<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ⚠️ **ここが無いと実機でカメラが許可できない。**
         Capacitor の初期状態は INTERNET だけで、カメラもマイクも
         宣言されていなかった。Web ブラウザでは動くのに、アプリに
         したとたん「カメラが許可できない」になる
         （2026-08-15、伊波さんが内部テストの実機で発見）。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- ⚠️ **保存のための権限は1つも宣言しない**（2026-08-16）。
         写真アプリへ直接しまう形（@capacitor-community/media）に変えたとき、
         権限を足して二度つまずいた。

           1回目 READ_MEDIA_IMAGES / READ_MEDIA_VIDEO を足した
                 → Play「申告されていない権限を使用しています」
                    これは「写真を読む」ための権限で、保存には要らない
           2回目 WRITE_EXTERNAL_STORAGE（maxSdkVersion 28）だけ残した
                 → Play「19,037台のデバイスがサポートされなくなりました」
                    権限を宣言すると、対応しない端末が除外される

         Android 10 (API 29) 以降は、自分のアプリから写真アプリへ
         書き込むのに権限が要らない。minSdk は 24 なので 9 以下も入るが、
         そこは Media が失敗したら共有シートに落ちる（save.ts）。
         **遊べなくなるより、古い端末で一手増えるほうがまし。** -->

    <!-- カメラが無い端末（一部のタブレット）でも入れられるようにする。
         required="true" にすると、そういう端末が Play の対象から外れる -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
</manifest>
